#!/bin/bash
set -u
set -o pipefail

# Read a local plaintext key, never source executable shell configuration.
ADMIN_KEY_FILE="${VLLM_ADMIN_KEY_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/vllm-gateway/admin.key}"
if [ -z "${VLLM_ADMIN_API_KEY:-}" ] && [ -r "$ADMIN_KEY_FILE" ]; then
    VLLM_ADMIN_API_KEY=$(<"$ADMIN_KEY_FILE")
    export VLLM_ADMIN_API_KEY
fi

# vLLM multi-model gateway companion script.
PROJECT_DIR="${VLLM_PROJECT_DIR:-$HOME/Projects/vllm}"
CONFIG_FILE="${VLLM_CONFIG_FILE:-$PROJECT_DIR/models.toml}"
PID_FILE="${VLLM_PID_FILE:-$HOME/.cache/vllm-gateway.pid}"
LOG_FILE="${VLLM_LOG_FILE:-$HOME/.cache/vllm-gateway.log}"
HOST="${VLLM_SERVICE_HOST:-0.0.0.0}"
PORT="${VLLM_SERVICE_PORT:-11432}"
DEFAULT_MODEL="${VLLM_DEFAULT_MODEL:-}"
BACKEND_PORT="${VLLM_BACKEND_PORT:-30000}"
BACKEND_PORT_COUNT="${VLLM_BACKEND_PORT_COUNT:-64}"
MAX_LOADED_MODELS="${VLLM_MAX_LOADED_MODELS:-}"
TP_SIZE="${VLLM_TP_SIZE:-}"
DP_SIZE="${VLLM_DP_SIZE:-}"
GPU_MEMORY_UTILIZATION="${VLLM_GPU_MEMORY_UTILIZATION:-}"
MAX_NUM_SEQS="${VLLM_MAX_NUM_SEQS:-}"
MAX_NUM_BATCHED_TOKENS="${VLLM_MAX_NUM_BATCHED_TOKENS:-}"
ATTENTION_BACKEND="${VLLM_ATTENTION_BACKEND:-}"
CONTEXT_LENGTH="${VLLM_CONTEXT_LENGTH:-}"
MODEL_IDLE_SECONDS="${VLLM_MODEL_IDLE_SECONDS:-}"
BACKEND_STARTUP_TIMEOUT="${VLLM_STARTUP_TIMEOUT:-900}"
BACKEND_SHUTDOWN_TIMEOUT="${VLLM_BACKEND_SHUTDOWN_TIMEOUT:-30}"
GATEWAY_START_TIMEOUT="${VLLM_GATEWAY_START_TIMEOUT:-30}"
STOP_TIMEOUT="${VLLM_STOP_TIMEOUT:-45}"
PRELOAD="${VLLM_PRELOAD:-0}"
PRELOAD_MODELS="${VLLM_PRELOAD_MODELS:-}"
CUDA_HOME="${VLLM_CUDA_HOME:-${CUDA_HOME:-/usr/local/cuda}}"
API_URL="http://127.0.0.1:$PORT"

mkdir -p "$(dirname "$PID_FILE")" "$(dirname "$LOG_FILE")"

service_python() {
    if [ -x "$PROJECT_DIR/.venv/bin/python" ]; then
        printf '%s\n' "$PROJECT_DIR/.venv/bin/python"
    elif command -v python3 >/dev/null 2>&1; then
        printf '%s\n' "python3"
    else
        return 1
    fi
}

pid_value() {
    [ -f "$PID_FILE" ] || return 1
    local pid
    pid=$(<"$PID_FILE")
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    printf '%s\n' "$pid"
}

pid_matches_gateway() {
    local pid="$1" cmdline
    kill -0 "$pid" 2>/dev/null || return 1
    if [ ! -r "/proc/$pid/cmdline" ]; then
        return 0
    fi
    cmdline=$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null) || return 1
    [[ "$cmdline" == *"vllm_gateway"* || "$cmdline" == *"vllm-service"* || "$cmdline" == *"vllm-gateway"* ]]
}

is_truthy() {
    case "${1,,}" in
    1|true|yes|on) return 0 ;;
    *) return 1 ;;
    esac
}

health_ok() {
    command -v curl >/dev/null 2>&1 || return 1
    curl --silent --fail --max-time 2 --output /dev/null "$API_URL/health"
}

ready_ok() {
    command -v curl >/dev/null 2>&1 || return 1
    curl --silent --fail --max-time 2 --output /dev/null "$API_URL/ready"
}

port_in_use() {
    (exec 9<>"/dev/tcp/127.0.0.1/$PORT") 2>/dev/null
}

start() {
    local existing=""
    existing=$(pid_value 2>/dev/null || true)
    if [ -n "$existing" ] && pid_matches_gateway "$existing"; then
        echo "vLLM gateway is already running (PID: $existing)."
        return 0
    fi
    [ -n "$existing" ] && rm -f "$PID_FILE"

    if [ ! -d "$PROJECT_DIR" ]; then
        echo "Project directory not found: $PROJECT_DIR" >&2
        return 1
    fi
    if [ ! -f "$CONFIG_FILE" ]; then
        echo "Configuration file not found: $CONFIG_FILE" >&2
        return 1
    fi
    if port_in_use; then
        echo "Port $PORT is already in use by a process not tracked in $PID_FILE; refusing to start or signal it." >&2
        return 1
    fi

    local python_bin
    python_bin=$(service_python) || {
        echo "No Python interpreter is available for the gateway." >&2
        return 1
    }
    local -a command
    if [ "$python_bin" = "$PROJECT_DIR/.venv/bin/python" ]; then
        command=("$python_bin" -m vllm_gateway)
    elif command -v uv >/dev/null 2>&1; then
        command=(uv run --project "$PROJECT_DIR" python -m vllm_gateway)
    else
        command=("$python_bin" -m vllm_gateway)
    fi
    command+=(
        --host "$HOST"
        --port "$PORT"
        --config "$CONFIG_FILE"
        --backend-port "$BACKEND_PORT"
        --backend-port-count "$BACKEND_PORT_COUNT"
        --startup-timeout "$BACKEND_STARTUP_TIMEOUT"
        --backend-shutdown-timeout "$BACKEND_SHUTDOWN_TIMEOUT"
    )
    [ -n "$DEFAULT_MODEL" ] && command+=(--default-model "$DEFAULT_MODEL")
    [ -n "$MAX_LOADED_MODELS" ] && command+=(--max-loaded-models "$MAX_LOADED_MODELS")
    [ -n "$TP_SIZE" ] && command+=(--tensor-parallel-size "$TP_SIZE")
    [ -n "$DP_SIZE" ] && command+=(--data-parallel-size "$DP_SIZE")
    [ -n "$GPU_MEMORY_UTILIZATION" ] && command+=(--gpu-memory-utilization "$GPU_MEMORY_UTILIZATION")
    [ -n "$MAX_NUM_SEQS" ] && command+=(--max-num-seqs "$MAX_NUM_SEQS")
    [ -n "$MAX_NUM_BATCHED_TOKENS" ] && command+=(--max-num-batched-tokens "$MAX_NUM_BATCHED_TOKENS")
    [ -n "$ATTENTION_BACKEND" ] && command+=(--attention-backend "$ATTENTION_BACKEND")
    [ -n "$CONTEXT_LENGTH" ] && command+=(--context-length "$CONTEXT_LENGTH")
    [ -n "$MODEL_IDLE_SECONDS" ] && command+=(--idle-seconds "$MODEL_IDLE_SECONDS")
    if is_truthy "$PRELOAD"; then
        command+=(--preload)
    fi
    if [ -n "$PRELOAD_MODELS" ]; then
        local -a preload_items
        local model
        IFS=',' read -r -a preload_items <<<"$PRELOAD_MODELS"
        for model in "${preload_items[@]}"; do
            model="${model#${model%%[![:space:]]*}}"
            model="${model%${model##*[![:space:]]}}"
            [ -n "$model" ] && command+=(--preload-model "$model")
        done
    fi

    echo "Starting vLLM gateway on $HOST:$PORT..."
    (
        cd "$PROJECT_DIR" || exit 1
        export PYTHONUNBUFFERED=1 CUDA_HOME
        if [ -d "$CUDA_HOME/bin" ]; then
            export PATH="$CUDA_HOME/bin:$PATH"
        fi
        exec setsid "${command[@]}"
    ) >>"$LOG_FILE" 2>&1 </dev/null &
    local pid=$!
    printf '%s\n' "$pid" >"$PID_FILE"

    local checks=$((GATEWAY_START_TIMEOUT * 2))
    local i
    for ((i = 0; i < checks; i++)); do
        if ! kill -0 "$pid" 2>/dev/null; then
            echo "vLLM gateway exited during startup. Logs: $LOG_FILE" >&2
            rm -f "$PID_FILE"
            return 1
        fi
        if health_ok; then
            if { ! is_truthy "$PRELOAD" && [ -z "$PRELOAD_MODELS" ]; } || ready_ok; then
                echo "Started vLLM gateway (PID: $pid)."
                echo "Endpoint: http://$HOST:$PORT"
                echo "Logs: $LOG_FILE"
                return 0
            fi
        fi
        sleep 0.5
    done

    echo "vLLM gateway did not become healthy within ${GATEWAY_START_TIMEOUT}s. Logs: $LOG_FILE" >&2
    kill "$pid" 2>/dev/null || true
    rm -f "$PID_FILE"
    return 1
}

stop() {
    local pid=""
    pid=$(pid_value 2>/dev/null || true)
    if [ -z "$pid" ]; then
        echo "vLLM gateway is not running."
        rm -f "$PID_FILE"
        return 0
    fi
    if ! pid_matches_gateway "$pid"; then
        if kill -0 "$pid" 2>/dev/null; then
            echo "PID $pid does not belong to this gateway; refusing to signal it." >&2
            rm -f "$PID_FILE"
            return 1
        fi
        echo "Removing stale vLLM gateway PID file."
        rm -f "$PID_FILE"
        return 0
    fi

    echo "Stopping vLLM gateway (PID: $pid)..."
    kill -TERM "$pid" 2>/dev/null || true
    local checks=$((STOP_TIMEOUT * 2))
    local i
    for ((i = 0; i < checks; i++)); do
        if ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$PID_FILE"
            echo "vLLM gateway stopped."
            return 0
        fi
        sleep 0.5
    done

    echo "Gateway did not stop within ${STOP_TIMEOUT}s; it was not force-killed so its owned backends can drain safely." >&2
    echo "Inspect $LOG_FILE and retry stop after active requests finish." >&2
    return 1
}

status() {
    local pid=""
    pid=$(pid_value 2>/dev/null || true)
    if [ -z "$pid" ] || ! pid_matches_gateway "$pid"; then
        echo "vLLM gateway is not running."
        return 3
    fi
    echo "vLLM gateway is running (PID: $pid)."
    echo "Endpoint: http://$HOST:$PORT"
    if ! command -v curl >/dev/null 2>&1; then
        echo "curl is required to inspect gateway health." >&2
        return 1
    fi
    if ! curl --silent --show-error --fail --max-time 3 "$API_URL/health"; then
        echo >&2
        echo "Gateway process exists but health check failed." >&2
        return 1
    fi
    echo
    if ready_ok; then
        echo "Readiness: ready"
    else
        echo "Readiness: no resident model is ready (lazy-load or loading state)"
    fi
}

models() {
    command -v curl >/dev/null 2>&1 || {
        echo "curl is required." >&2
        return 1
    }
    [ -n "${VLLM_ADMIN_API_KEY:-}" ] || { echo "VLLM_ADMIN_API_KEY is required." >&2; return 1; }
    printf 'Authorization: Bearer %s\n' "$VLLM_ADMIN_API_KEY" | \
        curl --silent --show-error --fail --max-time 5 \
        --header @- "$API_URL/admin/models"
    local result=$?
    echo
    return "$result"
}

load_model() {
    local model="${1:-}"
    [ -n "$model" ] || {
        echo "Usage: vllm load <model>" >&2
        return 2
    }
    command -v curl >/dev/null 2>&1 || {
        echo "curl is required." >&2
        return 1
    }
    [ -n "${VLLM_ADMIN_API_KEY:-}" ] || { echo "VLLM_ADMIN_API_KEY is required." >&2; return 1; }
    printf 'Authorization: Bearer %s\n' "$VLLM_ADMIN_API_KEY" | \
        curl --silent --show-error --fail-with-body --max-time "$BACKEND_STARTUP_TIMEOUT" \
        --header @- \
        --request POST "$API_URL/admin/models/$model/load"
    local result=$?
    echo
    return "$result"
}

unload_model() {
    local model="${1:-}"
    [ -n "$model" ] || {
        echo "Usage: vllm unload <model>" >&2
        return 2
    }
    command -v curl >/dev/null 2>&1 || {
        echo "curl is required." >&2
        return 1
    }
    [ -n "${VLLM_ADMIN_API_KEY:-}" ] || { echo "VLLM_ADMIN_API_KEY is required." >&2; return 1; }
    printf 'Authorization: Bearer %s\n' "$VLLM_ADMIN_API_KEY" | \
        curl --silent --show-error --fail-with-body --max-time "$BACKEND_SHUTDOWN_TIMEOUT" \
        --header @- \
        --request POST "$API_URL/admin/models/$model/unload"
    local result=$?
    echo
    return "$result"
}

download() {
    if [ ! -f "$CONFIG_FILE" ]; then
        echo "Configuration file not found: $CONFIG_FILE" >&2
        return 1
    fi
    local python_bin
    python_bin=$(service_python) || return 1
    echo "Downloading Hugging Face models declared in $CONFIG_FILE..."
    (
        cd "$PROJECT_DIR" || exit 1
        "$python_bin" - "$CONFIG_FILE" <<'PY'
import sys
from pathlib import Path

from huggingface_hub import snapshot_download
from vllm_gateway.catalog import ModelCatalog

catalog = ModelCatalog.from_file(Path(sys.argv[1]))
for spec in catalog.specs:
    source = spec.model_path or spec.hf_repo or ""
    expanded = Path(source).expanduser()
    if not source or expanded.exists() or source.startswith(("/", "./", "../", "~", "$")):
        continue
    print(f"--- {spec.name}: {source}", flush=True)
    print(snapshot_download(repo_id=source), flush=True)
PY
    )
}

show_logs() {
    local lines="${1:-100}"
    tail -n "$lines" "$LOG_FILE"
}

case "${1:-}" in
start) start ;;
stop) stop ;;
status) status ;;
restart)
    stop || exit $?
    start
    ;;
models) models ;;
load) load_model "${2:-}" ;;
unload) unload_model "${2:-}" ;;
download) download ;;
logs) show_logs "${2:-100}" ;;
*)
    echo "Usage: vllm {start|stop|status|restart|models|load <model>|unload <model>|download|logs [lines]}"
    exit 2
    ;;
esac
